    <flow id="flow_sn2" type="normalTraffic" route="route_sn" begin="25000" end="50000" vehsPerHour="100" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_se2" type="normalTraffic" route="route_se" begin="25000" end="50000" vehsPerHour="100" departSpeed="max" departPos="base" departLane="best"/>

    <flow id="flow_en2" type="normalTraffic" route="route_en" begin="25000" end="50000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ew2" type="normalTraffic" route="route_ew" begin="25000" end="50000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_es2" type="normalTraffic" route="route_es" begin="25000" end="50000" vehsPerHour="300" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_wn2" type="normalTraffic" route="route_wn" begin="25000" end="50000" vehsPerHour="300" departSpeed="max" departPos="base" departLane="best"/>
