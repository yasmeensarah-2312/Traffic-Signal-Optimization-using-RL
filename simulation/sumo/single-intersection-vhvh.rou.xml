    <flow id="flow_se3" type="normalTraffic" route="route_se" begin="50000" end="75000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>

    <flow id="flow_en3" type="normalTraffic" route="route_en" begin="50000" end="75000" vehsPerHour="100" departSpeed="max" departPos="base" departLane="best"/>
