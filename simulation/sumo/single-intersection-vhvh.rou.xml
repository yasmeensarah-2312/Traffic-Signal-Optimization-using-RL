    <flow id="flow_en4" type="normalTraffic" route="route_en" begin="75000" end="100000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ew4" type="normalTraffic" route="route_ew" begin="75000" end="100000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>
