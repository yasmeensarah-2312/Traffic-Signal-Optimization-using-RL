    <flow id="flow_ns4" type="normalTraffic" route="route_ns" begin="75000" end="100000" vehsPerHour="100" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_nw4" type="normalTraffic" route="route_nw" begin="75000" end="100000" vehsPerHour="100" departSpeed="max" departPos="base" departLane="best"/>
