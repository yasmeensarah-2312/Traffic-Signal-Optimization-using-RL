    <flow id="flow_we4" type="normalTraffic" route="route_we" begin="75000" end="100000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ws4" type="normalTraffic" route="route_ws" begin="75000" end="100000" vehsPerHour="350" departSpeed="max" departPos="base" departLane="best"/>

